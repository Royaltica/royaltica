{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && mkdir -p dist/_public && cp ../landing/index.html dist/_public/index.html",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|_public/).*)",
      "has": [{ "type": "header", "key": "host", "value": "royaltica.com" }],
      "destination": "/_public/index.html"
    },
    {
      "source": "/((?!api/|_public/).*)",
      "has": [{ "type": "header", "key": "host", "value": "www.royaltica.com" }],
      "destination": "/_public/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.royaltica.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
