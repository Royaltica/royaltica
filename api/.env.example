# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
# URL pública del frontend (links en correos, redirects de checkout, etc.)
FRONTEND_URL=http://localhost:5173
# Habilita el endpoint de login de desarrollo (sin Firebase). NUNCA 'true' en producción.
ALLOW_DEV_LOGIN=false

# ─── Database (PostgreSQL) ─────────────────────────────
# Runtime: rol de MÍNIMO privilegio (royaltica_app, sin superuser → RLS activo).
DATABASE_URL=postgresql://royaltica_app:<password>@localhost:5432/royaltica?schema=public
# Migraciones/seed: rol owner (npm run prisma:deploy lo usa automáticamente).
DATABASE_ADMIN_URL=postgresql://royaltica:royaltica@localhost:5432/royaltica?schema=public

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (sesiones propias del API) ────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=8h
# Llave dedicada (≥32 chars) para cifrar los secretos TOTP del 2FA.
# Si falta, se deriva de JWT_SECRET. Generar: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ─── Firebase Admin (verificación de ID tokens) ────────
# Del JSON de la cuenta de servicio (Firebase Console > Configuración
# del proyecto > Cuentas de servicio > Generar nueva clave privada).
# La private key va entre comillas y conserva los \n escapados.
# Si se dejan vacías, la app arranca pero /auth/* responde 503.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Google Cloud Storage (documentos KYC, CFDIs) ──────
GCS_BUCKET_NAME=
GCS_KEY_FILE=

# ─── Gemini (auditoría forense de facturas) ────────────
# Si VERTEX_PROJECT_ID está configurado, se usa Vertex AI en vez de GEMINI_API_KEY.
GEMINI_API_KEY=

# ─── Vertex AI (alternativa a Gemini API — GCP nativo) ──
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# Ruta al JSON de la cuenta de servicio con permiso Vertex AI User.
VERTEX_KEY_FILE=

# ─── Resend (emails transaccionales) ───────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@royaltica.com
# A dónde debe responder el cliente un recordatorio de cobranza (ver
# api/docs/cloudflare-email-worker/). Requiere Email Routing de Cloudflare
# configurado hacia esa dirección para que la respuesta se capture.
COLLECTIONS_REPLY_TO=cobranza@royaltica.com
# Correo del equipo al que llegan los leads (demo/contact) desde royaltica.com.
LEADS_EMAIL=hello@royaltica.com

# ─── Sentry (observabilidad, errores + traces) ─────────
# Sin SENTRY_DSN el SDK queda en modo no-op (no envía nada).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ─── Storage backend ───────────────────────────────────
# 'gcs' (default) usa las variables GCS_* de arriba.
# 's3' usa las variables S3_* (compatible con MinIO/AWS/R2/Backblaze).
STORAGE_PROVIDER=gcs
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Meilisearch (búsqueda instantánea) ────────────────
# Servicio recomendado como plugin de Railway (template Meilisearch).
MEILI_HOST=
MEILI_MASTER_KEY=

# ─── Slack incoming webhook (leads → canal #leads) ──────
# Opcional. Crear en https://api.slack.com/apps → Incoming Webhooks.
# Cuando llegue un lead nuevo, además del correo, se pushea a Slack.
SLACK_LEADS_WEBHOOK=

# ─── Stripe (pagos con tarjeta / suscripciones) ───────
# Dashboard: https://dashboard.stripe.com/apikeys
# Sin STRIPE_SECRET_KEY el modulo de pagos no arranca.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ─── PostHog (analytics server-side, opcional) ─────────
# Para tracking de eventos del backend (pagos, facturas, etc.)
# Sin key, es no-op.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ─── Swagger (protección en producción) ────────────────
SWAGGER_USER=admin
SWAGGER_PASS=change-me

# Verificación SAT (mock en dev determinista, live en producción)
SAT_VERIFY_MODE=live

# ─── WhatsApp (Meta Cloud API) ──────────────────────────
# Envío de alertas y recordatorios de cobranza. Sin token, corre en stub.
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_FROM=
# Webhook entrante (respuestas de clientes a los recordatorios de cobranza).
# VERIFY_TOKEN: lo eliges tú y lo pegas igual en el panel de Meta.
# APP_SECRET: el "App Secret" de tu app de Meta (valida la firma HMAC).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Factoraje (proveedor externo de anticipos) ─────────
FACTORAJE_API_URL=
FACTORAJE_API_KEY=

# ─── ERP (conector genérico de contabilidad externa) ────
ERP_API_URL=
ERP_API_KEY=

# ─── SPEI (dispersión de pagos interbancarios MX) ───────
# 'conekta' (default) o 'stp'. Sin SPEI_API_KEY corre en modo stub (no dispersa).
SPEI_PROVIDER=conekta
SPEI_API_KEY=
SPEI_API_URL=
# CLABE propia desde la que se dispersan los pagos.
SPEI_CLABE_ORIGEN=
# Límites de seguridad (pesos MXN). Default: 500,000 por transferencia, 2,000,000/día por org.
SPEI_MAX_AMOUNT_PER_TRANSFER=500000
SPEI_MAX_DAILY_TOTAL_PER_ORG=2000000

# ─── Jobs programados ────────────────────────────────────
# 'false' desactiva los recordatorios/cron (útil en CI o instancias de solo-lectura).
JOBS_ENABLED=true

# ─── Correo entrante (respuestas de cobranza) ───────────
# Cierra el ciclo: el cliente RESPONDE el recordatorio y su respuesta se
# clasifica, se registra en bitácora y se avisa a los responsables.
# Nunca marca una factura como pagada por sí sola.
#
# Endpoint: POST /webhooks/email
# Compatible con Resend inbound (firma Svix, secreto `whsec_...`) o con un
# reenviador propio (p. ej. Cloudflare Email Routing + Worker) que firme el
# cuerpo con HMAC-SHA256 y lo mande en la cabecera X-Royaltica-Signature.
# Si se deja vacío, la firma NO se valida (solo para desarrollo local).
EMAIL_INBOUND_SECRET=
